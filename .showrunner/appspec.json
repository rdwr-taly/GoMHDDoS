{
  "capabilities": {
    "can_redeploy": true,
    "can_resume": false,
    "can_stop": true,
    "can_update_while_running": true
  },
  "category": "Security Tools",
  "deployment": {
    "default_env_vars": [
      {
        "default_value": "GET",
        "label": "Attack Method",
        "name": "METHOD",
        "options": [
          "GET",
          "POST",
          "HEAD",
          "PUT",
          "DELETE",
          "OPTIONS",
          "PATCH",
          "BYPASS",
          "BOMB"
        ],
        "required": true,
        "tooltip": "Type of HTTP attack method to use",
        "type": "select"
      },
      {
        "label": "Target URL",
        "name": "URL",
        "required": true,
        "tooltip": "Target URL for the attack (e.g., https://target.com)",
        "type": "string"
      },
      {
        "default_value": 100,
        "label": "Attack Threads",
        "max": 10000,
        "min": 1,
        "name": "THREADS",
        "required": true,
        "tooltip": "Number of concurrent attack threads",
        "type": "integer"
      },
      {
        "default_value": 60,
        "label": "Duration (seconds)",
        "max": 3600,
        "min": 1,
        "name": "DURATION",
        "required": true,
        "tooltip": "Attack duration in seconds",
        "type": "integer"
      },
      {
        "default_value": 50,
        "label": "Requests Per Connection",
        "max": 1000,
        "min": 1,
        "name": "RPC",
        "required": false,
        "tooltip": "Number of requests per connection before reconnecting",
        "type": "integer"
      },
      {
        "default_value": "/app/files/proxies/http.txt",
        "label": "Proxy List File",
        "name": "PROXYFILE",
        "required": false,
        "tooltip": "Path to proxy list file (leave empty to disable proxies)",
        "type": "string"
      },
      {
        "label": "Cookie Header",
        "name": "COOKIE",
        "required": false,
        "tooltip": "Custom cookie header to include in requests",
        "type": "string"
      },
      {
        "label": "User Agent",
        "name": "USER_AGENT",
        "required": false,
        "tooltip": "Custom User-Agent header (leave empty for random)",
        "type": "string"
      },
      {
        "label": "Referer Header",
        "name": "REFERER",
        "required": false,
        "tooltip": "Custom Referer header for requests",
        "type": "string"
      },
      {
        "default_value": 10,
        "label": "Bandwidth Limit (Mbps)",
        "max": 10000,
        "min": 1,
        "name": "BANDWIDTH_LIMIT_MBPS",
        "required": false,
        "tooltip": "Maximum outgoing bandwidth in Mbps",
        "type": "integer"
      },
      {
        "default_value": 0,
        "label": "Network Latency (ms)",
        "max": 5000,
        "min": 0,
        "name": "LATENCY_MS",
        "required": false,
        "tooltip": "Artificial network latency to simulate",
        "type": "integer"
      },
      {
        "default_value": false,
        "label": "Debug Mode",
        "name": "DEBUG",
        "required": false,
        "tooltip": "Enable detailed logging and debug output",
        "type": "boolean"
      }
    ],
    "sdk_config_template": {
      "bandwidth_limit_mbps": "{{env.BANDWIDTH_LIMIT_MBPS}}",
      "cookie": "{{env.COOKIE}}",
      "debug": "{{env.DEBUG}}",
      "duration": "{{env.DURATION}}",
      "latency_ms": "{{env.LATENCY_MS}}",
      "method": "{{env.METHOD}}",
      "proxyfile": "{{env.PROXYFILE}}",
      "referer": "{{env.REFERER}}",
      "rpc": "{{env.RPC}}",
      "threads": "{{env.THREADS}}",
      "url": "{{env.URL}}",
      "user_agent": "{{env.USER_AGENT}}"
    },
    "volume_mounts_template": [
      {
        "container_path": "/app/files/proxies",
        "editable": true,
        "host_path_template": "/home/radware/proxies",
        "mode": "rw",
        "optional": true
      }
    ]
  },
  "deploymentContext": "app",
  "description": "High-performance Layer 7 Web DDoS attack tool using MHDDoS techniques for stress testing and security validation.",
  "displayName": "GoMHDDoS",
  "icon": "fas fa-bolt",
  "id": "gomhddos",
  "image_id_ref": "razor29/gomhddos",
  "monitoring": {
    "prometheus": {
      "enabled": true,
      "scrape_path": "/metrics",
      "scrape_port_number": 9090
    }
  },
  "subCategory": "DDoS Attack",
  "taskLifecycle": "stateful",
  "ui": {
    "card_basic_metrics": [
      {
        "label": "CPU",
        "max_value": 100,
        "source_path": "system.cpu_percent",
        "unit": "%"
      },
      {
        "label": "Memory",
        "max_value": 100,
        "source_path": "system.memory_percent",
        "unit": "%"
      }
    ],
    "card_info_fields": [
      {
        "label": "Target URL",
        "source_key": "URL",
        "source_type": "env_var"
      },
      {
        "label": "Attack Method",
        "source_key": "METHOD",
        "source_type": "env_var"
      },
      {
        "label": "Threads",
        "source_key": "THREADS",
        "source_type": "env_var"
      },
      {
        "label": "Duration",
        "source_key": "DURATION",
        "source_type": "env_var"
      }
    ],
    "card_live_update_fields": [
      "BANDWIDTH_LIMIT_MBPS"
    ],
    "card_primary_metric": [
      {
        "label": "Status",
        "source_path": "attack_status",
        "unit": ""
      },
      {
        "label": "Runs",
        "source_path": "attack_runs_total",
        "unit": ""
      }
    ],
    "card_secondary_metrics": [
      {
        "label": "Threads",
        "source_key": "THREADS",
        "source_type": "env_var",
        "unit": ""
      },
      {
        "label": "Duration",
        "source_key": "DURATION",
        "source_type": "env_var",
        "unit": "s"
      }
    ],
    "deployment_form_sections": [
      {
        "fields": [
          "METHOD",
          "URL",
          "THREADS",
          "DURATION",
          "RPC"
        ],
        "title": "Attack Configuration"
      },
      {
        "fields": [
          "PROXYFILE",
          "USER_AGENT",
          "REFERER",
          "COOKIE"
        ],
        "title": "Proxy & Headers"
      },
      {
        "fields": [
          "BANDWIDTH_LIMIT_MBPS",
          "LATENCY_MS",
          "DEBUG"
        ],
        "title": "Network Controls"
      }
    ]
  }
}
